# Configuration of automata-mcp. Copy to .env (optional) or set in the environment.
# The server has no secrets: the core has no authentication and neither has this server.

# Base URL of the Automata core (docker compose publishes it on 8080).
AUTOMATA_CORE_URL=http://localhost:8080

# stdio (local MCP clients) or streamable-http (Docker).
AUTOMATA_TRANSPORT=stdio
# Only used with streamable-http.
AUTOMATA_HTTP_HOST=0.0.0.0
AUTOMATA_HTTP_PORT=8000

# When set, context_uuid becomes optional in every tool and falls back to this value.
# AUTOMATA_DEFAULT_CONTEXT_UUID=

# httpx read timeout in seconds (the connect timeout is fixed at 5).
AUTOMATA_REQUEST_TIMEOUT_SECONDS=30
# Retries of GET requests on connect errors, 5xx and timeouts (backoff 0.5 s, 1 s). POST/PATCH are never retried.
AUTOMATA_GET_RETRIES=2

# Default cap, in bytes, of the text returned for a request/response body.
AUTOMATA_BODY_MAX_BYTES=65536
# Hard cap, in bytes, read from a body stream (including the skipped offset).
AUTOMATA_BODY_MAX_FETCH_BYTES=5242880
# Default cap, in bytes, of a job result returned in one call.
AUTOMATA_RESULT_MAX_BYTES=100000

# wait_for_jobs: poll interval, default wait and maximum wait of one call, in seconds.
# The maximum must stay under the MCP client's tool timeout.
AUTOMATA_WAIT_POLL_SECONDS=5
AUTOMATA_WAIT_DEFAULT_SECONDS=45
AUTOMATA_WAIT_MAX_SECONDS=55

# list_targets: maximum number of targets enriched with request metadata.
AUTOMATA_TARGET_ENRICH_LIMIT=50

AUTOMATA_LOG_LEVEL=INFO
