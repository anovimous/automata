# Copy this file to .env at the repository root (docker compose reads it from there) and set a
# different password for each service (hex or alphanumeric only, so they are safe in URLs).
# The user of all three is "automata". Changing a password after the first start does not change the
# one stored in the existing volumes: recreate them with `docker compose down -v` (the data is lost).
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RUSTFS_PASSWORD=change-me
